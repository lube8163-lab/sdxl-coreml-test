+private func fileSHA256(_ url: URL) async throws -> String {
+    // Multi-GB integrity checks must yield the main actor while the launch scene
+    // appears. Keep the complete SHA check, with bounded temporary storage.
+    try await Task.detached(priority: .userInitiated) {
+        let file = try FileHandle(forReadingFrom: url)
+        defer { try? file.close() }
+        var hasher = SHA256()
+        while true {
+            let count = try autoreleasepool { () throws -> Int in
+                guard let bytes = try file.read(upToCount: 1 << 20), !bytes.isEmpty else { return 0 }
+                hasher.update(data: bytes)
+                return bytes.count
+            }
+            if count == 0 { break }
+        }
+        return hasher.finalize().map { String(format: "%02x", $0) }.joined()
+    }.value
+}
 
